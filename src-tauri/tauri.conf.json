{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nook",
  "version": "1.0.0",
  "identifier": "com.lumina.notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nook",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#0D0E11",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown Note — Nook",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "Text Note — Nook",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NTJGNjU3QjI2RDkxQjUKUldTMWtXMnlWL1pTNXpWY2thTkFyNTVZTktxL25kbGVsUmJxbUZodS9PZmtkZTQ1OTZINno5NFAK",
      "endpoints": [
        "https://github.com/zeitgeist2004/Nook/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
